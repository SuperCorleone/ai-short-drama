{
  "_comment": "MiniMax-H3 Ref2VA · API 格式。接线照官方模板 video_minimax_h3_r2v.json（不是猜的）。三处对 A100 的必要偏离：①文本编码器换 int8_convrot（模板用的 NVFP4 是 Blackwell 专用，A100 sm_80 无 FP4 张量核）②length 必须落在 17k+5 网格上 ③ref_images 是 AUTOGROW 输入，prefix=ref_image_，max=9。注意本模型无 negative conditioning，用 BasicGuider 而非 CFGGuider。",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "20": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "",
      "width": 832,
      "height": 480,
      "length": 124,
      "ref_image_size": "match"
    }
  },
  "21": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["1", 0], "conditioning": ["20", 0] }
  },
  "22": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "23": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["1", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "24": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 42 }
  },
  "25": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["24", 0],
      "guider": ["21", 0],
      "sampler": ["22", 0],
      "sigmas": ["23", 0],
      "latent_image": ["20", 1]
    }
  },
  "26": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["25", 0], "vae": ["3", 0] }
  },
  "27": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["25", 0], "vae": ["4", 0] }
  },
  "28": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["26", 0], "audio": ["27", 0], "fps": 24 }
  },
  "29": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["28", 0],
      "filename_prefix": "h3ref/__OUT_NAME__",
      "format": "auto",
      "codec": "auto"
    }
  }
}
